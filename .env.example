# ==============================================
# AI Job Scraper & Resume Matcher — Environment
# ==============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/jobmatcher

# --- Auth ---
SECRET_KEY=change-me-to-a-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# --- LLM Provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Embeddings ---
VECTOR_DIMENSIONS=1536
EMBEDDING_MODEL=text-embedding-3-small

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File Uploads ---
MAX_UPLOAD_SIZE_MB=5

# --- Greenhouse Job Board ---
# Comma-separated whitelist of allowed board tokens (SSRF protection)
GREENHOUSE_BOARD_WHITELIST=airbnb,spotify,figma,cloudflare
